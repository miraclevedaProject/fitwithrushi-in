# Images and media: serve from cache instantly, refresh quietly in the
# background. Kept short enough that swapped client photos show up within a day.
/wp-content/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Every page: no one may show this site inside a frame on their own domain
# (the usual trick for passing a copied site off as the real one), and the
# browser must not guess file types.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Referrer-Policy: strict-origin-when-cross-origin
